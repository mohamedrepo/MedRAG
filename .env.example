# ===== MedRAG environment =====
# Copy to .env and adjust. Never commit real secrets.

APP_NAME=MedRAG
DEBUG=true
API_PREFIX=/api/v1

# SQLite for zero-dependency local run.
# Production: postgresql+psycopg://medrag:CHANGE_ME@localhost:5432/medrag
DATABASE_URL=sqlite:///E:/MedRAG/data/medrag.db
DB_ECHO=false

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=medrag-admin
ADMIN_EMAIL=admin@medrag.local

# Embeddings: local (no network) or openai-compatible endpoint
EMBEDDING_PROVIDER=local
EMBEDDING_API_BASE=http://localhost:1234/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-multilingual
EMBEDDING_DIM=256

# Optional LLM (never used to sort prices)
LLM_PROVIDER=none
LLM_API_BASE=http://localhost:1234/v1
LLM_API_KEY=
LLM_MODEL=

OCR_ENABLED=true
OCR_LANGUAGES=ara+eng

DEFAULT_CURRENCY=EGP
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_UPLOAD_MB=200
LOG_LEVEL=INFO
